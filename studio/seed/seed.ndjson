{"_id":"aboutPage","_type":"aboutPage","title":"About me","lead":"Hi, I’m Tuur Van Eynde, a 19-year-old sports photographer from Belgium.","body":[{"_type":"block","_key":"p1","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"p1s","text":"After finishing secondary school with a diploma in Print Media, I’m now studying Sports Management. What started as a camera on the sidelines has grown into sports photography across football, cycling, motorsport and equestrian events.","marks":[]}]},{"_type":"block","_key":"p2","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"p2s","text":"I focus on action, authenticity and detail — whether it’s during a race, in the pitlane or behind the scenes.","marks":[]}]}],"facts":[{"_key":"k0009","_type":"fact","label":"Based in","value":"Belgium"},{"_key":"k000a","_type":"fact","label":"Studying","value":"Sports Management"},{"_key":"k000b","_type":"fact","label":"Background","value":"Print Media"},{"_key":"k000c","_type":"fact","label":"Shoots","value":"Football · Cycling · Motorsport · Events"}],"primaryCtaLabel":"View my portfolio","secondaryCtaLabel":"Contact me","goalEyebrow":"My goal","goalText":"To tell the full story of sport through powerful images that leave a lasting impression."}
