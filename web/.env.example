# Copy to .env for local development. In Cloudflare Workers Builds, set these
# under Settings → Build → Variables and secrets.
# Leave PUBLIC_SANITY_PROJECT_ID empty to run the site on built-in demo content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Web3Forms access key (https://web3forms.com). Public by design.
PUBLIC_WEB3FORMS_KEY=
# Optional: override the canonical origin (defaults to https://tve.photo)
# PUBLIC_SITE_URL=https://tve.photo
