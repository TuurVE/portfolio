---
interface Props {
  size?: number;
  label?: string;
}
const { size = 64, label = 'TVE.photo home' } = Astro.props;
---

<a href="/" class="logo" aria-label={label} style={`--logo-size: ${size}px`}>
 <img src="/logotve.svg" alt="TVE.photo" width={size} height={size} />
</a>

<style>
  .logo {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--gold);
  }
  .tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
  .tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
  .br { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }
  .word {
    font-family: var(--font-display);
    font-size: var(--logo-size);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .word span {
    color: var(--gold-text);
  }
</style>
