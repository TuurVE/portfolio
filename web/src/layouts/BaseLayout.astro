---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGalleries, getSettings } from '../lib/content';
import { hasImage, imageUrl } from '../lib/sanity';
import type { Photo, Seo } from '../lib/types';

interface Props {
  /** Page-specific SEO from the CMS; falls back to the site defaults. */
  seo?: Seo;
  /** Used when the editor left the SEO title empty. */
  title?: string;
  description?: string;
  /** Used for og:image when no share image is set. */
  image?: Photo;
  /** JSON-LD nodes to add to the page's @graph. */
  schema?: object[];
  noIndex?: boolean;
}

const settings = await getSettings();
const galleries = await getGalleries();
const { seo, title, description, image, schema = [], noIndex } = Astro.props;

const siteTitle = settings.siteTitle;
const isHome = Astro.url.pathname === '/';
const pageTitle =
  seo?.title || (title && !isHome ? `${title} — ${siteTitle}` : settings.seo?.title || siteTitle);
const metaDescription = seo?.description || description || settings.seo?.description || settings.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const shareImage = [seo?.image, image, settings.seo?.image].find((p) => hasImage(p));
const ogImage = shareImage ? imageUrl(shareImage, 1200, { aspect: 1200 / 630, format: 'jpg' }) : undefined;
const robots = noIndex || seo?.noIndex ? 'noindex, follow' : undefined;
// Escape "<" so CMS text can never close the script tag early.
const jsonLd = schema.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#0a1512" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header settings={settings} galleries={galleries} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} galleries={galleries} />
  </body>
</html>
