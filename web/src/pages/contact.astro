---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { altFor, getContact, getPhotoIndex, getSettings, instagramUrl } from '../lib/content';

const [page, settings, photoIndex] = await Promise.all([getContact(), getSettings(), getPhotoIndex()]);
const insta = instagramUrl(settings);
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const thanksUrl = new URL('/contact/?sent=1', Astro.site).href;
---

<BaseLayout seo={page.seo} title="Contact" description={page.intro} image={page.image}>
  <section class="section contact">
    <div class="container layout">
      <div class="info">
        <SectionHeading as="h1">{page.title}</SectionHeading>
        {page.intro && <p class="lead">{page.intro}</p>}

        <div class="rows">
          {
            insta && (
              <a class="row" href={insta} rel="me noopener" target="_blank">
                <Icon name="instagram" class="gold-icon" />
                <span>@{settings.instagramHandle?.replace(/^@/, '')}</span>
                <span class="mono subtle">INSTAGRAM</span>
              </a>
            )
          }
          {
            settings.email && (
              <a class="row" href={`mailto:${settings.email}`}>
                <Icon name="mail" class="gold-icon" />
                <span>{settings.email}</span>
                <span class="mono subtle">EMAIL</span>
              </a>
            )
          }
          <div class="row">
            <Icon name="map-pin" class="gold-icon" />
            <span>{settings.location}</span>
            <span class="mono subtle">BASED IN</span>
          </div>
        </div>

        <Photo
          class="side-photo"
          photo={page.image}
          alt={altFor(page.image, 'Sports photo by Tuur Van Eynde', photoIndex)}
          aspect={3 / 2}
          widths={[480, 720, 1040]}
          sizes="(min-width: 1024px) 520px, 100vw"
        />
      </div>

      <!-- Web3Forms: works without JavaScript (redirects back with ?sent=1); the script below submits inline. -->
      <form class="form" method="POST" action="https://api.web3forms.com/submit" id="contact-form">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value={`New enquiry via ${settings.siteTitle}`} />
        <input type="hidden" name="from_name" value={settings.siteTitle} />
        <input type="hidden" name="redirect" value={thanksUrl} />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <label for="c-name">Name <span aria-hidden="true">*</span></label>
          <input id="c-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="c-email">Email address <span aria-hidden="true">*</span></label>
          <input id="c-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="c-msg">Message <span aria-hidden="true">*</span></label>
          <textarea id="c-msg" name="message" required rows="6" placeholder="Club, date, location and what you need"
          ></textarea>
        </div>
        <div class="submit">
          <button type="submit" class="btn btn--primary">
            {page.submitLabel || 'Send message'}
            <Icon name="arrow-right" size={18} stroke={2} />
          </button>
          <p class="small subtle">Fields marked * are required.</p>
          <p class="status small" role="status" aria-live="polite" data-success={page.successMessage || 'Thanks — your message has been sent.'}></p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('.status');
  if (form && status) {
    const success = status.dataset.success ?? '';
    if (new URLSearchParams(location.search).has('sent')) status.textContent = success;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Sending…';
      status.classList.remove('error');
      try {
        const data = Object.fromEntries(new FormData(form));
        delete data.redirect;
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message);
        form.reset();
        status.textContent = success;
      } catch {
        status.classList.add('error');
        status.textContent = 'Something went wrong. Please try again, or send me a message on Instagram.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
    max-width: 520px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 16px 0;
    color: var(--text);
  }
  .row > span:nth-of-type(2) {
    margin-left: auto;
  }
  .row :global(.gold-icon) {
    color: var(--gold-text);
  }
  a.row:hover {
    color: var(--gold-hover);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  label {
    font-size: 14px;
    line-height: 22px;
    font-weight: 600;
  }
  label span {
    color: var(--gold-text);
  }
  input:not([type='hidden']):not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    line-height: 26px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0 14px;
  }
  input:not([type='hidden']):not([type='checkbox']) {
    height: 48px;
  }
  textarea {
    padding: 12px 14px;
    resize: vertical;
    min-height: 160px;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--text-subtle);
  }
  .submit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .submit button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    color: var(--green);
  }
  .status:empty {
    display: none;
  }
  .status.error {
    color: #e8a08f;
  }

  @media (min-width: 1024px) {
    .contact {
      padding-bottom: 128px;
    }
    .layout {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 96px;
    }
    .form {
      width: 620px;
      flex-shrink: 0;
      padding: 40px;
    }
  }
</style>
